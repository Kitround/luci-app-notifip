{
	"luci-app-notifip": {
		"description": "Grant UCI and ubus access for NotifIP",
		"read": {
			"uci": [ "notifip" ],
			"ubus": {
				"luci.notifip": [ "status", "log" ]
			}
		},
		"write": {
			"uci": [ "notifip" ],
			"ubus": {
				"luci.notifip": [ "test_mail", "clear_log", "check_now" ]
			}
		}
	}
}
