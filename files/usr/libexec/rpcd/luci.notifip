#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# rpcd plugin: exposes luci.notifip.{status,log,test_mail,clear_log,check_now}

. /usr/share/libubox/jshn.sh

MSMTP_LOG=/tmp/msmtp.notifip.log

case "$1" in
	list)
		json_init
		json_add_object "status";    json_close_object
		json_add_object "log";       json_close_object
		json_add_object "test_mail"; json_close_object
		json_add_object "clear_log"; json_close_object
		json_add_object "check_now"; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)
				/usr/bin/notifip status
				;;
			log)
				/usr/bin/notifip log
				;;
			test_mail)
				out=$(/usr/bin/notifip test-mail 2>&1)
				rc=$?
				json_init
				json_add_int    "code"   "$rc"
				json_add_string "result" "$out"
				if [ -f "$MSMTP_LOG" ]; then
					json_add_string "log" "$(tail -n 50 "$MSMTP_LOG")"
				else
					json_add_string "log" ""
				fi
				json_dump
				;;
			clear_log)
				/usr/bin/notifip clear-log >/dev/null 2>&1
				rc=$?
				json_init
				json_add_int    "code"   "$rc"
				json_add_string "result" "OK"
				json_dump
				;;
			check_now)
				out=$(/usr/bin/notifip check-now 2>&1)
				rc=$?
				json_init
				json_add_int    "code"   "$rc"
				json_add_string "result" "$out"
				json_dump
				;;
			*)
				json_init
				json_add_string "error" "unknown method"
				json_dump
				exit 1
				;;
		esac
		;;
esac

exit 0
